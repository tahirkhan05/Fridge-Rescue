# Fridge Rescue Environment Variables Example
# Duplicate this file as .env and fill in your keys

# Roboflow API Key (for downloading Northumbria University Newcastle Smart Refrigerator dataset)
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Kaggle API Access Token (for downloading Fresh and Stale fruits/vegetables dataset)
# Can be generated at https://www.kaggle.com/settings/api
KAGGLE_API_TOKEN=your_kaggle_api_token_here

# Optional LLM API Key for GenAI Rescue Agent (System automatically falls back to intelligent heuristic agent if empty)
OPENAI_API_KEY=

# Server Configuration
PORT=8000
HOST=127.0.0.1
DATABASE_URL=sqlite:///./fridge_rescue.db
